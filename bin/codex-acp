#!/usr/bin/env node
/**
 * Codex ACP (Agent Client Protocol) Adapter
 * Exposes OpenAI Codex CLI as a standard ACP stdio server for Shadow Crew / Shinobi.
 */

import { spawn, execFileSync } from 'node:child_process';
import * as fs from 'node:fs';
import * as path from 'node:path';
import * as readline from 'node:readline';
import * as os from 'node:os';

const HOME = os.homedir();

/**
 * 子进程 PATH：GUI 守护进程继承的 PATH 往往不含用户 shell 的安装目录，这里显式补齐。
 * 探针与实际执行共用同一份 PATH，保证"探测通过 = 执行可用"。
 */
function codexChildEnv() {
  const searchPaths = [
    path.join(HOME, '.local/bin'),
    path.join(HOME, '.cargo/bin'),
    '/opt/homebrew/bin',
    '/usr/local/bin',
  ];
  return {
    ...process.env,
    PATH: [...searchPaths, process.env.PATH || ''].filter(Boolean).join(path.delimiter),
  };
}

/**
 * 判定一个路径是否真的是可执行的普通文件。
 * 关键点：必须 realpath + stat + X_OK 三重校验——断链软链（如升级 ChatGPT.app 后
 * ~/.local/bin/codex 指向已删除的旧路径）在 existsSync/access 下会以 ENOENT 形式暴露，
 * 绝不能被当成可用二进制。
 */
function resolveExecutable(p) {
  if (!p) return null;
  try {
    const real = fs.realpathSync(p);
    const st = fs.statSync(real);
    if (!st.isFile() || st.size === 0) return null;
    fs.accessSync(real, fs.constants.X_OK);
    return real;
  } catch {
    return null;
  }
}

/** 显式 PATH 查找（每个目录逐一校验），不使用 shell 猜测 */
function lookupOnPath(name) {
  for (const dir of (process.env.PATH || '').split(path.delimiter).filter(Boolean)) {
    const resolved = resolveExecutable(path.join(dir, name));
    if (resolved) return resolved;
  }
  return null;
}

/**
 * Codex 二进制的已知安装布局（按优先级）：
 * - ChatGPT / Codex 桌面端 bundle 现行布局（codex-package.json layoutVersion 1）：
 *   <App>.app/Contents/Resources/codex-cli/bin/codex → CodexCLI.app/Contents/MacOS/codex
 * - 旧版桌面端布局：<App>.app/Contents/Resources/codex（0.15x 之前）
 * - 独立安装：Homebrew / npm / cargo / uv 等
 */
function codexCandidatePaths() {
  return [
    path.join(HOME, '.local/bin/codex'),
    path.join(HOME, '.codex/plugins/.plugin-appserver/codex'),
    '/Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex',
    '/Applications/ChatGPT.app/Contents/Resources/codex',
    '/Applications/Codex.app/Contents/Resources/codex-cli/bin/codex',
    '/Applications/Codex.app/Contents/Resources/codex',
    path.join(HOME, 'Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex'),
    path.join(HOME, 'Applications/Codex.app/Contents/Resources/codex-cli/bin/codex'),
    '/opt/homebrew/bin/codex',
    '/usr/local/bin/codex',
    path.join(HOME, '.cargo/bin/codex'),
    path.join(HOME, '.bun/bin/codex'),
    path.join(HOME, '.npm-global/bin/codex'),
  ].filter(Boolean);
}

function findCodexBinary() {
  // 用户显式指定的二进制优先级最高；若其无效则直接判定不可用，绝不静默回退到其他候选
  const explicit = process.env.CODEX_BINARY;
  if (explicit) {
    const resolved = resolveExecutable(explicit);
    if (resolved) return { bin: resolved, probed: [explicit], explicitInvalid: null };
    return { bin: null, probed: [explicit], explicitInvalid: explicit };
  }

  const probed = [];
  for (const c of codexCandidatePaths()) {
    probed.push(c);
    const resolved = resolveExecutable(c);
    if (resolved) return { bin: resolved, probed, explicitInvalid: null };
  }

  const onPath = lookupOnPath('codex');
  if (onPath) return { bin: onPath, probed: [...probed, `PATH:codex`], explicitInvalid: null };

  return { bin: null, probed, explicitInvalid: null };
}

const codexResolution = findCodexBinary();
const CODEX_BIN = codexResolution.bin;

function codexUnavailableReason() {
  if (codexResolution.explicitInvalid) {
    return `环境变量 CODEX_BINARY 指向的路径不是可执行文件：${codexResolution.explicitInvalid}`;
  }
  return `未找到可执行的 codex 二进制（已探测：${codexResolution.probed.join('、')}）`;
}

let cachedCodexVersion = null;
function codexVersion() {
  if (cachedCodexVersion) return cachedCodexVersion;
  try {
    const out = execFileSync(CODEX_BIN, ['--version'], {
      timeout: 5000,
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
      env: codexChildEnv(),
    }).trim();
    const matched = out.match(/\d+\.\d+\.[0-9A-Za-z.\-]+/);
    cachedCodexVersion = matched ? matched[0] : out.split('\n').pop() || 'unknown';
  } catch {
    cachedCodexVersion = 'unknown';
  }
  return cachedCodexVersion;
}

// 会话状态管理与持久化缓存 (独立会话文件存储，彻底杜绝多进程覆盖 ~/.shadow-crew/cache/codex_sessions/<sessionId>.json)
const SESSIONS_CACHE_ROOT = path.join(HOME, '.shadow-crew', 'cache');
const SESSIONS_DIR = path.join(SESSIONS_CACHE_ROOT, 'codex_sessions');
const LEGACY_CACHE_FILE = path.join(SESSIONS_CACHE_ROOT, 'codex_sessions.json');

/**
 * @typedef {Object} SessionState
 * @property {string} sessionId - ACP 会话 ID
 * @property {string} cwd - 工作区目录
 * @property {string[]} additionalDirectories - 挂载目录
 * @property {string} systemPrompt - 注入系统提示词
 * @property {string|null} codexThreadId - Codex CLI 底层真实 thread_id
 * @property {number} createdAt
 * @property {number} updatedAt
 */

/** @type {Map<string, SessionState>} */
const sessions = new Map();
let activeSessionId = null;

function sanitizeSessionFileName(sessionId) {
  return sessionId.replace(/[^a-zA-Z0-9_\-\.]/g, '_');
}

function getSessionFilePath(sessionId) {
  return path.join(SESSIONS_DIR, `${sanitizeSessionFileName(sessionId)}.json`);
}

function loadSession(sessionId) {
  if (!sessionId) return null;
  if (sessions.has(sessionId)) {
    return sessions.get(sessionId);
  }

  // 1. 优先从专用单个会话独立文件读取
  try {
    const file = getSessionFilePath(sessionId);
    if (fs.existsSync(file)) {
      const raw = fs.readFileSync(file, 'utf8');
      const data = JSON.parse(raw);
      if (data && data.sessionId) {
        sessions.set(data.sessionId, data);
        return data;
      }
    }
  } catch {}

  // 2. 回退检查遗留全局 codex_sessions.json (平滑兼容老数据)
  try {
    if (fs.existsSync(LEGACY_CACHE_FILE)) {
      const raw = fs.readFileSync(LEGACY_CACHE_FILE, 'utf8');
      const list = JSON.parse(raw);
      if (Array.isArray(list)) {
        const found = list.find((item) => item && item.sessionId === sessionId);
        if (found) {
          saveSession(found);
          return found;
        }
      }
    }
  } catch {}

  return null;
}

function saveSession(session) {
  if (!session || !session.sessionId) return;
  sessions.set(session.sessionId, session);
  try {
    if (!fs.existsSync(SESSIONS_DIR)) {
      fs.mkdirSync(SESSIONS_DIR, { recursive: true });
    }
    const targetFile = getSessionFilePath(session.sessionId);
    const tmpFile = `${targetFile}.tmp.${process.pid}.${Date.now()}`;
    fs.writeFileSync(tmpFile, JSON.stringify(session, null, 2), 'utf8');
    fs.renameSync(tmpFile, targetFile);
  } catch {}
}

function deleteSession(sessionId) {
  if (!sessionId) return;
  sessions.delete(sessionId);
  try {
    const targetFile = getSessionFilePath(sessionId);
    if (fs.existsSync(targetFile)) {
      fs.unlinkSync(targetFile);
    }
  } catch {}
}

function sendRpc(msg) {
  const str = JSON.stringify(msg);
  process.stdout.write(str + '\n');
}

function sendNotification(method, params) {
  sendRpc({
    jsonrpc: '2.0',
    method,
    params,
  });
}

function sendResult(id, result) {
  sendRpc({
    jsonrpc: '2.0',
    id,
    result,
  });
}

function sendError(id, code, message) {
  sendRpc({
    jsonrpc: '2.0',
    id,
    error: { code, message },
  });
}

const rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout,
  terminal: false,
});

rl.on('line', async (line) => {
  const trimmed = line.trim();
  if (!trimmed) return;

  let request;
  try {
    request = JSON.parse(trimmed);
  } catch (err) {
    return;
  }

  const { id, method, params } = request;

  // 1. initialize
  if (method === 'initialize') {
    // 后端二进制缺失时直接以 JSON-RPC error 拒绝握手，避免平台把"适配器存活"误判为"Agent 可用"
    if (!CODEX_BIN) {
      sendError(
        id,
        -32001,
        `Codex ACP 适配器不可用：${codexUnavailableReason()}。请安装 Codex CLI，或设置 CODEX_BINARY 指向可执行文件。`
      );
      return;
    }
    sendResult(id, {
      protocolVersion: 1,
      agentInfo: {
        name: 'OpenAI Codex',
        version: codexVersion(),
        description: 'OpenAI Codex CLI ACP Agent',
      },
      agentCapabilities: {
        loadSession: false,
        tools: { listChanged: true },
        streaming: true,
        sessionCapabilities: {
          resume: {},
        },
      },
      capabilities: {
        prompts: { listChanged: true },
        tools: { listChanged: true },
        streaming: true,
      },
      sessionCapabilities: {
        resume: {},
      },
      _meta: {
        codexBinary: CODEX_BIN,
      },
    });
    return;
  }

  // 2. session/new
  if (method === 'session/new') {
    const sessionId = `codex-sess-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
    const sessionState = {
      sessionId,
      cwd: params?.cwd || process.cwd(),
      additionalDirectories: Array.isArray(params?.additionalDirectories)
        ? params.additionalDirectories.filter(Boolean)
        : [],
      systemPrompt: params?.systemPrompt || '',
      codexThreadId: null,
      createdAt: Date.now(),
      updatedAt: Date.now(),
    };
    activeSessionId = sessionId;
    saveSession(sessionState);

    sendResult(id, {
      sessionId,
    });
    return;
  }

  // 3. session/resume
  if (method === 'session/resume') {
    const targetSessionId = params?.sessionId;
    if (!targetSessionId) {
      sendError(id, -32602, 'Missing sessionId parameter for session/resume');
      return;
    }
    const session = loadSession(targetSessionId);
    if (!session) {
      sendError(id, -32004, `Session not found: ${targetSessionId}`);
      return;
    }
    if (params?.cwd) {
      session.cwd = params.cwd;
    }
    if (Array.isArray(params?.additionalDirectories)) {
      session.additionalDirectories = params.additionalDirectories.filter(Boolean);
    }
    session.updatedAt = Date.now();
    activeSessionId = targetSessionId;
    saveSession(session);
    sendResult(id, {});
    return;
  }

  // 4. session/close
  if (method === 'session/close') {
    const targetSessionId = params?.sessionId || activeSessionId;
    if (targetSessionId) {
      deleteSession(targetSessionId);
      if (activeSessionId === targetSessionId) {
        activeSessionId = null;
      }
    }
    sendResult(id, { closed: true });
    return;
  }

  // 5. session/prompt
  if (method === 'session/prompt') {
    if (!CODEX_BIN) {
      sendResult(id, {
        text_response: `⚠️ Codex 不可用：${codexUnavailableReason()}。`,
        stopReason: 'error',
      });
      return;
    }

    const targetSessionId = params?.sessionId || activeSessionId;
    let session = targetSessionId ? loadSession(targetSessionId) : null;
    if (!session) {
      const newSid = targetSessionId || `codex-sess-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`;
      session = {
        sessionId: newSid,
        cwd: params?.cwd || process.cwd(),
        additionalDirectories: Array.isArray(params?.additionalDirectories)
          ? params.additionalDirectories.filter(Boolean)
          : [],
        systemPrompt: params?.systemPrompt || '',
        codexThreadId: null,
        createdAt: Date.now(),
        updatedAt: Date.now(),
      };
      activeSessionId = newSid;
      saveSession(session);
    }

    if (params?.cwd) {
      session.cwd = params.cwd;
    }
    if (Array.isArray(params?.additionalDirectories)) {
      session.additionalDirectories = params.additionalDirectories.filter(Boolean);
    }

    const rawPrompt = params?.prompt;
    let userPromptText = '';

    if (typeof rawPrompt === 'string') {
      userPromptText = rawPrompt;
    } else if (Array.isArray(rawPrompt)) {
      userPromptText = rawPrompt
        .map((p) => (typeof p === 'string' ? p : p.text || ''))
        .filter(Boolean)
        .join('\n');
    } else if (rawPrompt && typeof rawPrompt === 'object' && rawPrompt.text) {
      userPromptText = rawPrompt.text;
    }

    const hasThread = Boolean(session.codexThreadId);
    // 当已有底座 Codex thread 时，底层会话已记忆首次注入的系统公约与花名册，
    // 此时仅发送增量 userPromptText，严禁重复前置长篇系统提示词以避免 Token 浪费
    const fullPrompt = (hasThread || !session.systemPrompt)
      ? userPromptText
      : `${session.systemPrompt}\n\n${userPromptText}`;

    // 方案 A：精准开放工作区写权限 (-s workspace-write)，保证 Agent 能正常落盘 artifacts/scratch，
    // 同时通过 Seatbelt 沙箱阻断对外部目录的越界篡改。
    // 若 session 已成功记录真实的 codexThreadId，调用 codex exec resume 续接会话！
    const args = ['exec'];

    if (hasThread) {
      args.push('resume', session.codexThreadId, '-');
    }

    if (process.env.CODEX_DANGEROUSLY_BYPASS_SANDBOX === '1') {
      args.push('--dangerously-bypass-approvals-and-sandbox');
    } else if (!hasThread) {
      const sandboxMode = process.env.CODEX_SANDBOX || 'workspace-write';
      args.push('-s', sandboxMode);
    }

    args.push('--skip-git-repo-check', '--json');

    if (!hasThread) {
      if (session.cwd && fs.existsSync(session.cwd)) {
        args.push('--cd', session.cwd);
      }
      for (const dir of session.additionalDirectories) {
        if (typeof dir === 'string' && fs.existsSync(dir)) {
          args.push('--add-dir', dir);
        }
      }
      args.push('-');
    }

    let fullOutput = '';
    let hasSentChunk = false;

    const child = spawn(CODEX_BIN, args, {
      cwd: session.cwd && fs.existsSync(session.cwd) ? session.cwd : undefined,
      env: codexChildEnv(),
      stdio: ['pipe', 'pipe', 'pipe'],
    });

    // Pipe the user prompt into stdin
    child.stdin.write(fullPrompt);
    child.stdin.end();

    const outRl = readline.createInterface({
      input: child.stdout,
      terminal: false,
    });

    outRl.on('line', (outLine) => {
      const outTrimmed = outLine.trim();
      if (!outTrimmed) return;

      try {
        const event = JSON.parse(outTrimmed);

        // 捕获首次启动时 Codex 分配的真实 thread_id
        if (event.type === 'thread.started' && event.thread_id) {
          session.codexThreadId = event.thread_id;
          session.updatedAt = Date.now();
          saveSession(session);
        }

        if (event.type === 'item.completed' && event.item) {
          if (event.item.type === 'agent_message' && event.item.text) {
            const text = event.item.text;
            fullOutput += (fullOutput ? '\n\n' : '') + text;
            hasSentChunk = true;
            // Emit ACP session/update chunk
            sendNotification('session/update', {
              sessionId: session.sessionId,
              update: {
                sessionUpdate: 'agent_message_chunk',
                content: { text },
              },
            });
          }
        }
      } catch {
        // Raw non-JSON line
        if (outTrimmed && !outTrimmed.startsWith('{')) {
          fullOutput += (fullOutput ? '\n' : '') + outTrimmed;
          sendNotification('session/update', {
            sessionId: session.sessionId,
            update: {
              sessionUpdate: 'agent_message_chunk',
              content: { text: outTrimmed },
            },
          });
        }
      }
    });

    let stderrBuffer = '';
    child.stderr.on('data', (data) => {
      stderrBuffer += data.toString();
    });

    child.on('close', (code) => {
      session.updatedAt = Date.now();
      saveSession(session);
      if (code !== 0 && !fullOutput) {
        sendResult(id, {
          text_response: `⚠️ Codex 执行退出 (exit code: ${code})\n${stderrBuffer.trim()}`,
          stopReason: 'error',
        });
      } else {
        sendResult(id, {
          text_response: fullOutput || '（Codex 执行完成，无输出文本）',
          stopReason: 'completed',
        });
      }
    });

    child.on('error', (err) => {
      sendResult(id, {
        text_response: `⚠️ 无法启动 Codex 进程 (${CODEX_BIN}): ${err.message}\n${codexUnavailableReason()}。`,
        stopReason: 'error',
      });
    });

    return;
  }

  // Fallback for unknown methods
  if (id !== undefined) {
    sendResult(id, {});
  }
});
